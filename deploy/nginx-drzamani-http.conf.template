limit_req_zone $binary_remote_addr zone=drz_otp:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=drz_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=drz_verify:10m rate=30r/m;

server {
    listen 80;
    server_name __DOMAIN__ www.__DOMAIN__;

    root /var/www/drzamani/current/public_html;
    index index.html;
    client_max_body_size 11m;
    limit_req_status 429;
    include /etc/nginx/snippets/drzamani-security-headers.conf;

    location ^~ /articles/ { return 410; }
    location = /articles { return 410; }

    location ^~ /.well-known/acme-challenge/ {
        allow all;
    }

    location = /api/v1/auth/otp/request {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        limit_req zone=drz_otp burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/drzamani-proxy-headers.conf;
        proxy_set_header Connection "";
    }

    location = /api/v1/auth/otp/verify {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        limit_req zone=drz_verify burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/drzamani-proxy-headers.conf;
        proxy_set_header Connection "";
    }

    location = /api/v1/staff/auth/login {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        limit_req zone=drz_auth burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/drzamani-proxy-headers.conf;
        proxy_set_header Connection "";
    }

    location = /api/v1/staff/auth/captcha {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        limit_req zone=drz_verify burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/drzamani-proxy-headers.conf;
        proxy_set_header Connection "";
    }

    location = /api/v1/realtime {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/drzamani-proxy-headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ^~ /api/ {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/snippets/drzamani-proxy-headers.conf;
        proxy_set_header Connection "";
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/drzamani-security-headers.conf;
    }

    # Initial public HTML and SEO read the latest clinic row on every request.
    # Activate with the matching API release; assets remain served by Nginx.
    location = / { if (-f /var/www/drzamani/maintenance.flag) { return 503; } proxy_pass http://127.0.0.1:8000; include /etc/nginx/snippets/drzamani-proxy-headers.conf; proxy_set_header Connection ""; }
    location = /index.html { return 301 /; }
    location = /appointment { return 301 /appointment/; }
    location = /staff { return 301 /staff/; }
    location = /staff/index.html { return 301 /staff/; }
    location = /appointment/index.html { return 301 /appointment/; }
    location = /appointment/ { if (-f /var/www/drzamani/maintenance.flag) { return 503; } proxy_pass http://127.0.0.1:8000; include /etc/nginx/snippets/drzamani-proxy-headers.conf; proxy_set_header Connection ""; }
    location = /staff/ { if (-f /var/www/drzamani/maintenance.flag) { return 503; } proxy_pass http://127.0.0.1:8000; include /etc/nginx/snippets/drzamani-proxy-headers.conf; proxy_set_header Connection ""; }
    location = /sitemap.xml { proxy_pass http://127.0.0.1:8000; include /etc/nginx/snippets/drzamani-proxy-headers.conf; proxy_set_header Connection ""; }
    location = /robots.txt { proxy_pass http://127.0.0.1:8000; include /etc/nginx/snippets/drzamani-proxy-headers.conf; proxy_set_header Connection ""; }
    location = /404.html { proxy_pass http://127.0.0.1:8000; include /etc/nginx/snippets/drzamani-proxy-headers.conf; proxy_set_header Connection ""; }

    location ~* \.(?:webp|png|jpg|jpeg|svg|woff2)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/drzamani-security-headers.conf;
    }

    location / {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
    error_page 503 /maintenance.html;
    location = /maintenance.html {
        root /var/www/drzamani/shared;
        internal;
    }

}
