limit_req_zone $binary_remote_addr zone=drz_otp:10m rate=10r/m;

server {
    listen 80;
    server_name __DOMAIN__ www.__DOMAIN__;

    root /var/www/drzamani/current/public_html;
    index index.html;
    client_max_body_size 11m;

    location ^~ /articles/ { return 410; }
    location = /articles { return 410; }

    location ^~ /.well-known/acme-challenge/ {
        allow all;
    }

    location = /api/v1/auth/otp/request {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        limit_req zone=drz_otp burst=3 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(?:webp|png|jpg|jpeg|svg|woff2)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        if (-f /var/www/drzamani/maintenance.flag) { return 503; }
        try_files $uri $uri/ =404;
    }

    error_page 503 /maintenance.html;
    location = /maintenance.html {
        root /var/www/drzamani/shared;
        internal;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
}
