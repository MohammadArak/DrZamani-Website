APP_NAME="Dr Zamani Appointment API"
APP_ENV=production
APP_DEBUG=false
API_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
DATABASE_URL=sqlite:////var/lib/drzamani/appointments_v2.db
ALLOWED_ORIGINS=https://drfarzadzamani.ir,https://www.drfarzadzamani.ir
PATIENT_SESSION_DAYS=7
STAFF_SESSION_HOURS=12
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_IP_HOUR=20
OTP_VERIFY_MAX_PER_IP_MINUTE=30
OTP_VERIFY_MAX_PER_PHONE_HOUR=30
STAFF_LOGIN_MAX_ATTEMPTS=5
STAFF_LOGIN_LOCK_SECONDS=900
STAFF_LOGIN_MAX_PER_IP_WINDOW=30
CAPTCHA_MAX_PER_IP_HOUR=60
SMS_PROVIDER=faraz
FARAZ_API_KEY=CHANGE_ME
FARAZ_PATTERN_CODE=CHANGE_ME
FARAZ_LINE_NUMBER=CHANGE_ME
FARAZ_OTP_VARIABLE=code
UPLOAD_DIR=/var/lib/drzamani/uploads
MAX_UPLOAD_BYTES=10485760
FRONTEND_URL=https://drfarzadzamani.ir
BOOKING_ENABLED=false
BOOKING_DISABLED_MESSAGE=رزرو آنلاین نوبت فعلاً غیرفعال است. برای هماهنگی با مطب تماس بگیرید.
BOOKING_HOLD_MINUTES=12
ZARINPAL_MERCHANT_ID=CHANGE_ME
ZARINPAL_SANDBOX=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Runtime secrets are encrypted separately from session signing.
# Generate privately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated: current key first, previous keys only for decrypting history.
SETTINGS_ENCRYPTION_KEYS=
# Exact approved HTTPS webhook hosts, no wildcard/IP; restart API and jobs after ENV changes.
SMS_WEBHOOK_ALLOWED_HOSTS=
# Absolute path of built frontend on deployment; default ../public_html relative to API source.
# PUBLIC_HTML_DIR=/var/www/drzamani/current/public_html

# External providers stay off until owner browser/server verification succeeds.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
GOOGLE_ENABLED=false
GOOGLE_SITE_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_API_KEY=
GOOGLE_MIN_SCORE=50
CAPTCHA_PRIMARY=turnstile
CAPTCHA_FALLBACK=false
CAPTCHA_STAFF_LOGIN=true
CAPTCHA_OTP_REQUEST=true
CAPTCHA_OTP_VERIFY=true
# Exact CSV hostnames, no scheme/wildcard; empty derives frontend/allowed origins.
CAPTCHA_HOSTNAMES=
# Enable in owner settings only after every active owner enrolls and saves recovery codes.
MFA_REQUIRED_OWNERS=false

# Separate editorial WebP storage; never point at patient uploads or static web root.
PUBLIC_MEDIA_DIR=
