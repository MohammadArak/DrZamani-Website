# -----------------------------------------------------------------------------
# Dr Zamani Appointment API
# Copy this file to .env and replace every CHANGE_ME value before production.
# Never commit the real .env file.
# -----------------------------------------------------------------------------

# Application
APP_NAME="Dr Zamani Appointment API"
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# SQLite is the supported database. PostgreSQL needs separate compatibility work.
DATABASE_URL=sqlite:///./data/appointments_v2.db

# Comma-separated origins. Leave empty when frontend and API share one domain.
# Example: https://drfarzadzamani.ir,https://www.drfarzadzamani.ir
ALLOWED_ORIGINS=

# Authentication sessions
PATIENT_SESSION_DAYS=7
STAFF_SESSION_HOURS=12

# OTP security and rate limits
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_IP_HOUR=20
OTP_VERIFY_MAX_PER_IP_MINUTE=30
OTP_VERIFY_MAX_PER_PHONE_HOUR=30
STAFF_LOGIN_MAX_ATTEMPTS=5
STAFF_LOGIN_LOCK_SECONDS=900
STAFF_LOGIN_MAX_PER_IP_WINDOW=30
CAPTCHA_MAX_PER_IP_HOUR=60

# SMS
# development: console (OTP is returned only when APP_DEBUG=true)
# production with Faraz SMS: set SMS_PROVIDER=faraz and fill all FARAZ_* values.
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_SENDER=
FARAZ_API_KEY=
FARAZ_PATTERN_CODE=
FARAZ_LINE_NUMBER=
FARAZ_OTP_VARIABLE=code

# Consultation image uploads (JPEG, PNG or WebP; optimized to WebP on upload)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# Booking payments (amounts are stored and sent as toman / IRT)
FRONTEND_URL=http://localhost:5173
BOOKING_HOLD_MINUTES=12
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Optional one-time first administrator.
# Set both values only for first startup, then remove them from .env.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Runtime secrets are encrypted separately from session signing.
# Generate privately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated: current key first, previous keys only for decrypting history.
SETTINGS_ENCRYPTION_KEYS=
# Exact approved HTTPS webhook hosts, no wildcard/IP; restart API and jobs after ENV changes.
SMS_WEBHOOK_ALLOWED_HOSTS=
# Absolute path of built frontend on deployment; default ../public_html relative to API source.
# PUBLIC_HTML_DIR=/var/www/drzamani/current/public_html
